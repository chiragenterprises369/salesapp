  "dashboardWidgets": [],
  "reports": [],
  "importMappings": [
    {
      "key": "indiamart_csv",
      "name": "IndiaMART enquiries",
      "source": "indiamart",
      "target": "lead",
      "fields": [
        {
          "from": "UNIQUE_QUERY_ID",
          "to": "sourceRef",
          "transform": "trim"
        },
        {
          "from": "SENDER_NAME",
          "to": "name",
          "transform": "trim"
        },
        {
          "from": "SENDER_COMPANY",
          "to": "companyName",
          "transform": "trim"
        },
        {
          "from": "SENDER_MOBILE",
          "to": "phone",
          "transform": "phone_in"
        },
        {
          "from": "SENDER_EMAIL",
          "to": "email",
          "transform": "lower"
        },
        {
          "from": "SENDER_CITY",
          "to": "city",
          "transform": "trim"
        },
        {
          "from": "SENDER_STATE",
          "to": "state",
          "transform": "trim"
        },
        {
          "from": "QUERY_PRODUCT_NAME",
          "to": "productInterest",
          "transform": "trim"
        },
        {
          "from": "QUERY_MESSAGE",
          "to": "requirement",
          "transform": "none"
        },
        {
          "from": "QUERY_QUANTITY",
          "to": "custom.quantity",
          "transform": "trim"
        }
      ],
      "defaults": {
        "source": "indiamart"
      }
    }
  ],
