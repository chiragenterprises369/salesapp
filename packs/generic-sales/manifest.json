          {
            "id": "trigger",
            "type": "trigger.schedule",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "config": {
                "cron": "0 11 * * 1",
                "leadFilter": {
                  "stageKeys": [
                    "contacted",
                    "interested"
                  ],
                  "inactiveDays": 30,
                  "tags": []
                }
              }
            }
          },
          {
            "id": "offer",
            "type": "action.send_whatsapp_template",
            "position": {
              "x": 0,
              "y": 150
            },
            "data": {
              "config": {
                "templateName": "revival_offer",
                "language": "en",
                "variables": {
                  "1": "{{lead.firstName}}"
                }
              }
            }
          },
          {
            "id": "wait",
            "type": "logic.wait",
            "position": {
              "x": 0,
              "y": 300
            },
            "data": {
              "config": {
                "amount": 3,
                "unit": "days",
                "businessHoursOnly": true,
                "resumeOnReply": true
              }
            }
          },
          {
            "id": "replied",
            "type": "logic.condition",
            "position": {
              "x": 0,
              "y": 450
            },
            "data": {
              "label": "Replied?",
              "config": {
                "kind": "replied",
                "since": "last_outbound"
              }
            }
          },
          {
            "id": "revived",
            "type": "action.add_tag",
            "position": {
              "x": -300,
              "y": 600
            },
            "data": {
              "config": {
                "tags": [
                  "revived"
                ]
              }
            }
          },
          {
            "id": "task",
            "type": "action.create_task",
            "position": {
              "x": -300,
              "y": 750
            },
            "data": {
              "config": {
                "title": "{{lead.name}} replied to revival offer",
                "dueInMinutes": 60,
                "priority": "high",
                "assignTo": "owner"
              }
            }
          },
          {
            "id": "dormant",
            "type": "action.add_tag",
            "position": {
              "x": 300,
              "y": 600
            },
            "data": {
              "config": {
                "tags": [
                  "dormant"
                ]
              }
            }
          }
        ],
        "edges": [
          {
            "id": "trigger-out-offer",
            "source": "trigger",
            "target": "offer",
            "sourceHandle": "out",
            "targetHandle": "in"
          },
          {
            "id": "offer-out-wait",
            "source": "offer",
            "target": "wait",
            "sourceHandle": "out",
            "targetHandle": "in"
          },
          {
            "id": "wait-out-replied",
            "source": "wait",
            "target": "replied",
            "sourceHandle": "out",
            "targetHandle": "in"
          },
          {
            "id": "replied-yes-revived",
            "source": "replied",
            "target": "revived",
            "sourceHandle": "yes",
            "targetHandle": "in"
          },
          {
            "id": "revived-out-task",
            "source": "revived",
            "target": "task",
            "sourceHandle": "out",
            "targetHandle": "in"
          },
          {
            "id": "replied-no-dormant",
            "source": "replied",
            "target": "dormant",
            "sourceHandle": "no",
            "targetHandle": "in"
          }
        ]
      }
    }
  ],
  "whatsappTemplates": [
    {
      "name": "indiamart_welcome",
      "category": "utility",
      "language": "en",
      "body": "Namaste {{1}}, thank you for your enquiry with {{2}} about {{3}}. Reply PRICE for rates or CATALOG for details.",
      "variables": [
        "lead.firstName",
        "workspace.name",
        "lead.productInterest"
      ]
    },
    {
      "name": "price_list",
      "category": "utility",
      "language": "en",
