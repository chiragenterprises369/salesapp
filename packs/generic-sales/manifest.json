{
  "schemaVersion": 1,
  "key": "generic-sales",
  "name": "Generic Sales",
  "version": "1.0.0",
  "description": "Lead pipeline, follow-up workflows and WhatsApp templates for any business that sells by phone and WhatsApp.",
  "industry": "General",
  "icon": "BriefcaseBusiness",
  "core": true,
  "modes": [],
  "labels": {},
  "objects": [],
  "fields": [
    {
      "target": "lead",
      "field": {
        "key": "gst_number",
        "label": "GST number",
        "helpText": "15-character GSTIN of the buyer",
        "required": false,
        "unique": false,
        "access": {
          "hiddenFor": [],
          "readOnlyFor": []
        },
        "type": "text",
        "config": {
          "maxLength": 15,
          "multiline": false,
          "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
          "patternMessage": "Enter a valid 15-character GSTIN, e.g. 24ABCDE1234F1Z5"
        }
      }
    },
    {
      "target": "lead",
      "field": {
        "key": "quantity",
        "label": "Quantity required",
        "helpText": "e.g. 500 kg or 20 pieces",
        "required": false,
        "unique": false,
        "access": {
          "hiddenFor": [],
          "readOnlyFor": []
        },
        "type": "text",
        "config": {
          "maxLength": 80,
          "multiline": false
        }
      }
    },
    {
      "target": "lead",
      "field": {
        "key": "preferred_language",
        "label": "Preferred language",
        "required": false,
        "unique": false,
        "access": {
          "hiddenFor": [],
          "readOnlyFor": []
        },
        "type": "select",
        "config": {
          "options": [
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "gu",
              "label": "Gujarati"
            },
            {
              "value": "mr",
              "label": "Marathi"
            },
            {
              "value": "ta",
              "label": "Tamil"
            },
            {
              "value": "te",
              "label": "Telugu"
            },
            {
              "value": "kn",
              "label": "Kannada"
            },
            {
              "value": "bn",
              "label": "Bengali"
            }
          ]
        }
      }
    },
    {
      "target": "lead",
      "field": {
        "key": "delivery_by",
        "label": "Delivery by",
        "required": false,
        "unique": false,
        "access": {
          "hiddenFor": [],
          "readOnlyFor": []
        },
        "type": "date",
        "config": {
          "withTime": false
        }
      }
    }
  ],
  "pipelines": [
    {
      "key": "sales",
      "name": "Sales",
      "isDefault": true,
      "stages": [
        {
          "key": "new",
          "name": "New",
          "type": "open",
          "probability": 5
        },
        {
          "key": "contacted",
          "name": "Contacted",
          "type": "open",
          "probability": 15
        },
        {
          "key": "interested",
          "name": "Interested",
          "type": "open",
          "probability": 35
        },
        {
          "key": "quote_sent",
          "name": "Quote sent",
          "type": "open",
          "probability": 60
        },
        {
          "key": "won",
          "name": "Won",
          "type": "won",
          "probability": 100
        },
        {
          "key": "lost",
          "name": "Lost",
          "type": "lost",
          "probability": 0
        }
      ]
    }
  ],
  "roles": [],
  "workflowTemplates": [
    {
      "key": "indiamart_nurturing",
      "name": "IndiaMART nurturing",
      "description": "Dedupe, create contact and deal, send welcome, branch on reply intent, follow up and create a call task.",
      "graph": {
        "schemaVersion": 1,
        "version": 0,
        "nodes": [
          {
            "id": "trigger",
            "type": "trigger.indiamart_lead",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "config": {}
            }
          },
          {
            "id": "dedupe",
            "type": "logic.dedupe",
            "position": {
              "x": 0,
              "y": 150
            },
            "data": {
              "config": {
                "matchBy": [
                  "phone",
                  "sourceRef"
                ],
                "withinDays": 90
              }
            }
          },
          {
            "id": "stop_dup",
            "type": "logic.stop",
            "position": {
              "x": 300,
              "y": 300
            },
            "data": {
              "label": "Stop: duplicate",
              "config": {
                "reason": "Duplicate enquiry"
              }
            }
          },
          {
            "id": "contact",
            "type": "action.upsert_contact",
            "position": {
              "x": 0,
              "y": 300
            },
            "data": {
              "label": "Create contact + deal",
              "config": {
                "createDeal": true,
                "dealValueInr": null
              }
            }
          },
          {
            "id": "assign",
            "type": "action.assign_owner",
            "position": {
              "x": 0,
              "y": 450
            },
            "data": {
              "config": {
                "strategy": "round_robin",
                "userIds": [],
                "rules": [],
                "onlyIfUnassigned": true
              }
            }
          },
          {
            "id": "welcome",
            "type": "action.send_whatsapp_template",
            "position": {
              "x": 0,
              "y": 600
            },
            "data": {
              "label": "WhatsApp welcome",
              "config": {
                "templateName": "indiamart_welcome",
                "language": "en",
                "variables": {
                  "1": "{{lead.firstName}}",
                  "2": "{{workspace.name}}",
                  "3": "{{lead.productInterest}}"
                }
              }
            }
          },
          {
            "id": "wait_2h",
            "type": "logic.wait",
            "position": {
              "x": 0,
              "y": 750
            },
            "data": {
              "config": {
                "amount": 2,
                "unit": "hours",
                "businessHoursOnly": true,
                "resumeOnReply": true
              }
            }
          },
          {
            "id": "replied",
            "type": "logic.condition",
            "position": {
              "x": 0,
              "y": 900
            },
            "data": {
              "label": "Replied?",
              "config": {
                "kind": "replied",
                "since": "last_outbound"
              }
            }
          },
          {
            "id": "intent",
            "type": "logic.switch",
            "position": {
              "x": -300,
              "y": 1050
            },
            "data": {
              "label": "Intent",
              "config": {
                "on": "reply_keyword",
                "cases": [
                  {
                    "key": "price",
                    "label": "Price",
                    "op": "contains",
                    "value": [
                      "price",
                      "rate",
                      "cost",
                      "kitna",
                      "quotation",
                      "quote"
                    ]
                  },
                  {
                    "key": "catalog",
                    "label": "Catalog",
                    "op": "contains",
                    "value": [
                      "catalog",
                      "catalogue",
                      "brochure",
                      "details",
                      "photos"
                    ]
                  },
                  {
                    "key": "not_interested",
                    "label": "Not interested",
                    "op": "contains",
                    "value": [
                      "not interested",
                      "no need",
                      "stop",
                      "nahi"
                    ]
                  }
                ]
              }
            }
          },
          {
            "id": "price_list",
            "type": "action.send_whatsapp_template",
            "position": {
              "x": -600,
              "y": 1200
            },
            "data": {
              "label": "Send price list",
              "config": {
                "templateName": "price_list",
                "language": "en",
                "variables": {
                  "1": "{{lead.firstName}}"
                }
              }
            }
          },
          {
            "id": "price_task",
            "type": "action.create_task",
            "position": {
              "x": -600,
              "y": 1350
            },
            "data": {
              "label": "Task for rep",
              "config": {
                "title": "Follow up on price enquiry: {{lead.name}}",
                "dueInMinutes": 60,
                "priority": "high",
                "assignTo": "owner"
              }
            }
          },
          {
            "id": "catalog",
