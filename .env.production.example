# Vistar production settings for deploy/docker-compose.prod.yml (change #20). See docs/DEPLOY.md.
# Copy to deploy/.env.production on the server, fill it in, chmod 600. Never commit the filled file.
# Only bootstrap values live here. Mail, storage credentials, Google, WhatsApp, telephony, Sentry, Razorpay,
# Firebase and templates are set in Super Admin > Config (stored encrypted); env values below are fallbacks.
# The API refuses to start in production with example or short secrets, http URLs, dev settings or mocks.

# ---- Hosts (DNS A/AAAA records point at this server) ----
VISTAR_WEB_HOST=app.example.in
VISTAR_API_HOST=api.example.in
WEB_ORIGIN=https://app.example.in
API_PUBLIC_URL=https://api.example.in
# Customers point their custom domain (CNAME) at this host; it must resolve to this server.
CUSTOM_DOMAIN_CNAME_TARGET=domains.example.in
# Let's Encrypt / ZeroSSL account e-mail (expiry notices)
ACME_EMAIL=ops@example.in
APP_VERSION=

# ---- Secrets: generate each one, never reuse (openssl rand -base64 48) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SUPER_JWT_SECRET=
# 32 bytes, base64 (openssl rand -base64 32). Encrypts every stored secret: back it up with the database backups,
# a lost key means re-entering every panel secret.
ENCRYPTION_KEY=

# ---- Database and Redis (containers on the internal network, no published ports) ----
# At least 12 random characters (openssl rand -hex 24)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Pool per API process; keep (api + worker processes) x DB_POOL_MAX below POSTGRES_MAX_CONNECTIONS
DB_POOL_MAX=10
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
REDIS_MAXMEMORY=256mb

# ---- First Super Admin (used once by the seed job; 2FA is enrolled on first login) ----
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# ---- Workers: set off when the `worker` profile runs the hub jobs in their own container ----
API_HUB_BACKGROUND_JOBS=on

# ---- Logs ----
LOG_LEVEL=log

# ---- Optional env fallbacks (the panel wins) ----
# Error monitoring: Super Admin > Config > Error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# File storage: Super Admin > Config > File storage (s3 or bunny; local disk is refused in production)
STORAGE_DRIVER=
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# Google sign-in and Calendar: Super Admin > Config > Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Map tiles for the web field map (build time) ----
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# ---- Backups (profile backup) ----
# true when the backup profile runs (Super Admin > Go-live; each successful run also records a heartbeat)
BACKUP_ENABLED=true
# Daily at BACKUP_TIME (Asia/Kolkata), or every BACKUP_EVERY_HOURS hours
BACKUP_TIME=02:30
BACKUP_EVERY_HOURS=
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30
# Strongly recommended: the dump holds customer data. Keep the passphrase outside the server too.
BACKUP_ENCRYPTION_PASSPHRASE=
# s3 | bunny | none. Use a separate bucket or storage zone from the app files.
BACKUP_TARGET=none
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=vistar/db
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BUNNY_STORAGE_ZONE=
BACKUP_BUNNY_PASSWORD=
# Region host of the storage zone: storage.bunnycdn.com (Falkenstein), sg.storage.bunnycdn.com (Singapore), ...
BACKUP_BUNNY_REGION_HOST=storage.bunnycdn.com
BACKUP_BUNNY_PREFIX=vistar/db
# Optional dead-man switch (healthchecks.io or similar); /fail is appended on failure
BACKUP_HEALTHCHECK_URL=
