// Vistar data model. OWNER: orchestrator (contract). Agents request changes via the orchestrator.
// Rules:
//  - Every table except Workspace and platform tables (PlatformAdmin, PlatformSession, PlatformAuditLog,
//    PlanDefinition, PackDefinition, PackVersion, PackPlanEntitlement, PlatformFile, PlatformSetting,
//    AndroidRelease) carries workspaceId and is indexed by it.
//  - Enum literals MUST equal the values in packages/shared/src/enums.ts.
//  - Money is whole rupees (Int), except the CRM documents of change #19 wave B (products, price lists, deal
//    lines, quotations, invoices, payments): paise in BigInt columns named *Paise (D-067). Ids are UUIDv7.
//  - Use the tenant client (PrismaService.forTenant) with UNCHECKED inputs (scalar *Id fields, no `connect`).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

