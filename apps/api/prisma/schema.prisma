  authorId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId, createdAt])
}

/// Calendar meeting (SPEC 29.9). recurrence = Recurrence JSON; seriesEndAt = end of the last occurrence (range queries).
model Meeting {
  id             String        @id @default(uuid(7)) @db.Uuid
  workspaceId    String        @db.Uuid
  title          String
  description    String?
  /// in_person | video | phone
  mode           String        @default("in_person")
  location       String?
  videoUrl       String?
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean       @default(false)
  timezone       String        @default("Asia/Kolkata")
  status         MeetingStatus @default(scheduled)
  organizerId    String?       @db.Uuid
  leadId         String?       @db.Uuid
  contactId      String?       @db.Uuid
  companyId      String?       @db.Uuid
  dealId         String?       @db.Uuid
  /// Minutes before the start
  reminders      Int[]         @default([15])
  recurrence     Json?
  seriesEndAt    DateTime?
  /// YYYY-MM-DD of cancelled or detached occurrences
  exceptionDates String[]      @default([])
  /// Detached occurrence -> its series
  seriesId       String?       @db.Uuid
  outcome        String?
  cancelReason   String?
  createdById    String?       @db.Uuid
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizer User?             @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  lead      Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact   Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal      Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  attendees MeetingAttendee[]

  @@index([workspaceId, startAt])
  @@index([workspaceId, organizerId, startAt])
  @@index([workspaceId, leadId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, dealId])
}

model MeetingAttendee {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  meetingId   String           @db.Uuid
  userId      String?          @db.Uuid
  contactId   String?          @db.Uuid
  name        String
  email       String?
  response    AttendeeResponse @default(pending)
  respondedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@index([workspaceId, userId])
  @@index([workspaceId, contactId])
}

/// Sent reminders (idempotency across API instances).
model MeetingReminderLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  meetingId       String   @db.Uuid
  occurrenceStart DateTime
  minutesBefore   Int
  sentAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([meetingId, occurrenceStart, minutesBefore])
  @@index([workspaceId, sentAt])
}

/// Leave, holiday or training of a user (calendar availability, lead routing).
model TimeOff {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  /// leave | holiday | training | other
  kind        String   @default("leave")
  startAt     DateTime
  endAt       DateTime
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, startAt])
  @@index([workspaceId, startAt])
}

/// Lead routing rule (schemas/routing.ts). lastAssignedUserId is the round-robin cursor (row-locked when advanced).
model RoutingRule {
  id                  String    @id @default(uuid(7)) @db.Uuid
  workspaceId         String    @db.Uuid
  name                String
  active              Boolean   @default(true)
  priority            Int
  /// RoutingConditions JSON
  conditions          Json      @default("{}")
  /// round_robin | least_busy
  strategy            String    @default("round_robin")
  teamId              String?   @db.Uuid
  userIds             String[]  @default([]) @db.Uuid
  respectWorkingHours Boolean   @default(true)
  respectAvailability Boolean   @default(true)
  requireOnline       Boolean   @default(false)
  fallbackOwnerId     String?   @db.Uuid
  lastAssignedUserId  String?   @db.Uuid
  assignedCount       Int       @default(0)
  lastAssignedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active, priority])
}

/// Lead capture form (schemas/capture.ts). key = public id in /f/<key> and /public/forms/<key>.
model CaptureForm {
