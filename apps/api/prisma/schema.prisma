model Tag {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

/// Field definition of the flexible data layer (custom fields on core entities and custom object fields).
/// Values live in the entity's `customFields` JSON or in CustomRecord.values. Archive only; keys are never reused.
model CustomField {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @db.Uuid
  /// Core entity (lead | contact | company | deal | task | call) or object:<key>
  target         String
  /// Set when target is object:<key>
  customObjectId String?   @db.Uuid
  key            String
  label          String
  /// FIELD_TYPES in @vistar/shared (text, number, money, date, select, multi_select, user, relation, file, geo_point, boolean, url)
  type           String
  /// Per-type config (FIELD_CONFIG_SCHEMAS), e.g. { options } for select
  config         Json      @default("{}")
  /// FieldAccess { hiddenFor, readOnlyFor } by Role.key
  access         Json      @default("{\"hiddenFor\": [], \"readOnlyFor\": []}")
  helpText       String?
  required       Boolean   @default(false)
  isUnique       Boolean   @default(false)
  order          Int       @default(0)
  /// Pack that created the field (null = workspace-defined); pack fields keep key and type locked
  packKey        String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customObject CustomObject? @relation(fields: [customObjectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, target, key])
  @@index([workspaceId, target, order])
}

/// Workspace-defined record type (e.g. Supplier, or Project/Unit from a pack). Archive only.
model CustomObject {
  id              String    @id @default(uuid(7)) @db.Uuid
  workspaceId     String    @db.Uuid
  key             String
  labelSingular   String
  labelPlural     String
  /// lucide-react icon name
  icon            String    @default("Box")
  description     String?
  /// Key of the text field used as the record title
  primaryFieldKey String
  showInNav       Boolean   @default(true)
  packKey         String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields    CustomField[]
  records   CustomRecord[]

  @@unique([workspaceId, key])
}

/// One record of a custom object. values = { fieldKey: value } validated by validateCustomValues().
model CustomRecord {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  objectId    String    @db.Uuid
  /// Denormalised value of the object's primary (title) field
  title       String    @default("")
  values      Json      @default("{}")
  /// Data scope (own | team | all) applies through ownerId
  ownerId     String?   @db.Uuid
  createdById String?   @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  object    CustomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  owner     User?        @relation("RecordOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, objectId, createdAt])
  @@index([workspaceId, objectId, ownerId])
  @@index([values(ops: JsonbPathOps)], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "CustomRecord_title_trgm_idx")
}

/// Industry Pack activation in a workspace. Super Admin entitlement overrides live here too (written via the root client).
model WorkspacePack {
  id               String    @id @default(uuid(7)) @db.Uuid
  workspaceId      String    @db.Uuid
  packKey          String
  /// active | uninstalled | failed | not_installed (row created only for a Super Admin override)
  status           String    @default("not_installed")
  installedVersion String?
  /// Modes enabled at activation (e.g. developer, broker)
  modes            String[]  @default([])
  /// Super Admin override: grant | revoke | null (follow the plan)
  platformOverride String?
  overrideReason   String?
  lastError        String?
  installedAt      DateTime?
  uninstalledAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, packKey])
}

/// Every install / upgrade / uninstall / sync attempt (success, noop or failed).
model PackInstallLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  packKey     String
  /// install | upgrade | uninstall | sync
  action      String
  fromVersion String?
  toVersion   String?
  modes       String[]       @default([])
  /// success | noop | failed
  status      String
  /// summarizeOps() counts
  summary     Json           @default("{}")
  /// PackConflict[]
  conflicts   Json           @default("[]")
  error       String?
  actorType   AuditActorType @default(user)
  actorId     String?        @db.Uuid
  actorName   String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, packKey, createdAt])
}

model SavedView {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  ownerId     String?  @db.Uuid
  name        String
  entity      String   @default("lead")
  filters     Json
  columns     String[] @default([])
  /// board | table | null (keep the user's current view)
  viewMode    String?
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ownerId])
}

model File {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @db.Uuid
  leadId       String?  @db.Uuid
  /// Storage object key (driver-relative); never exposed. Served via signed URLs or, for public files, /api/files/p/{id}
  key          String
  name         String
  mime         String
  size         Int
  uploadedById String?  @db.Uuid
  /// Super Admin who uploaded it for the company (floor models); uploadedById is then null
  uploadedByAdminId String? @db.Uuid
  purpose      FilePurpose    @default(attachment)
  visibility   FileVisibility @default(private)
  /// Storage driver that holds the bytes (local | s3)
  driver       String   @default("s3")
  sha256       String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, leadId])
  @@index([workspaceId, purpose])
}

model ImportJob {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  createdById String?      @db.Uuid
  status      ImportStatus @default(previewed)
  fileKey     String
  fileName    String
  columns     String[]
  rowCount    Int          @default(0)
  mapping     Json?
  created     Int          @default(0)
  updated     Int          @default(0)
  skipped     Int          @default(0)
  errors      Json         @default("[]")
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------- tasks

model Task {
  id                String       @id @default(uuid(7)) @db.Uuid
  workspaceId       String       @db.Uuid
  type              TaskType     @default(todo)
  title             String
  notes             String?
  status            TaskStatus   @default(open)
  priority          TaskPriority @default(normal)
  leadId            String?      @db.Uuid
  assigneeId        String?      @db.Uuid
  createdById       String?      @db.Uuid
  dueAt             DateTime?
  remindAt          DateTime?
  snoozedUntil      DateTime?
  completedAt       DateTime?
  overdueNotifiedAt DateTime?
  source            TaskSource   @default(manual)
  workflowRunId     String?      @db.Uuid
  customFields      Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, assigneeId, status, dueAt])
  @@index([workspaceId, leadId])
  @@index([workspaceId, status, dueAt])
}

// ---------------------------------------------------------------- calls & messaging

model Call {
  id             String        @id @default(uuid(7)) @db.Uuid
  workspaceId    String        @db.Uuid
  leadId         String?       @db.Uuid
  userId         String?       @db.Uuid
  direction      CallDirection
  status         CallStatus    @default(ringing)
  outcome        CallOutcome?
  fromNumber     String
  toNumber       String
  startedAt      DateTime      @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int           @default(0)
  /// S3 key; never exposed directly
  recordingKey   String?
  recordingPeaks Json?
  provider       String
  providerCallId String?
  notes          String?
  disposition    String?
  customFields   Json          @default("{}")
  /// sim (Android app) | voip (telephony adapter) | mock
  source         CallSource    @default(voip)
  /// Technical result (device call log / telephony); outcome stays the rep's disposition
  result         CallResult?
  /// Counterpart number in E.164 (lead matching)
  phone          String?
  /// Android CallLog id, unique per user (idempotent device-log ingestion)
  deviceCallId   String?
  /// App-generated id of the live call (POST /me/calls/active), completed by the call-log row
  clientCallId   String?
  deviceId       String?       @db.Uuid
  recordingFileId String?      @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, provider, providerCallId])
  @@unique([workspaceId, userId, deviceCallId])
  @@unique([workspaceId, userId, clientCallId])
  @@index([workspaceId, userId, startedAt])
  @@index([workspaceId, leadId])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, phone])
}

model Conversation {
  id                 String             @id @default(uuid(7)) @db.Uuid
  workspaceId        String             @db.Uuid
  channel            Channel            @default(whatsapp)
  contactId          String             @db.Uuid
  leadId             String?            @db.Uuid
  assigneeId         String?            @db.Uuid
  status             ConversationStatus @default(open)
  unreadCount        Int                @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  /// Start of the 24h customer-service window
  lastInboundAt      DateTime?
  businessNumberId   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@unique([workspaceId, channel, contactId])
  @@index([workspaceId, assigneeId, lastMessageAt])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id                String           @id @default(uuid(7)) @db.Uuid
  workspaceId       String           @db.Uuid
  conversationId    String           @db.Uuid
  direction         MessageDirection
  type              MessageType      @default(text)
  body              String?
  templateId        String?          @db.Uuid
  templateName      String?
  mediaFileId       String?          @db.Uuid
  status            MessageStatus    @default(queued)
  error             String?
  providerMessageId String?
  isInternalNote    Boolean          @default(false)
  authorId          String?          @db.Uuid
  workflowRunId     String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerMessageId])
  @@index([workspaceId, conversationId, createdAt])
}

model Template {
  id                 String           @id @default(uuid(7)) @db.Uuid
  workspaceId        String           @db.Uuid
  channel            Channel          @default(whatsapp)
  name               String
  language           String           @default("en")
  category           TemplateCategory
  status             TemplateStatus   @default(draft)
  body               String
  variables          String[]         @default([])
  header             String?
  footer             String?
  providerTemplateId String?
  /// Pack that suggested the template (null = created by the workspace)
  packKey            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channel, name, language])
}

model QuickReply {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  shortcut    String
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
}

model ConsentRecord {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  contactId   String        @db.Uuid
  channel     Channel
  status      ConsentStatus
  source      ConsentSource
  evidence    Json?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactId, channel, createdAt])
}

// ---------------------------------------------------------------- workflows

model Workflow {
  id              String         @id @default(uuid(7)) @db.Uuid
  workspaceId     String         @db.Uuid
  name            String
  description     String?
  status          WorkflowStatus @default(draft)
  triggerType     String?
  activeVersionId String?        @db.Uuid
  latestVersion   Int            @default(0)
  /// Editable draft WorkflowGraph
  draft           Json
  templateKey     String?
  createdById     String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  WorkflowVersion[]
  runs      WorkflowRun[]

  @@index([workspaceId, status, triggerType])
}

model WorkflowVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  workflowId  String   @db.Uuid
  version     Int
  graph       Json
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workspaceId])
}

model WorkflowRun {
  id             String            @id @default(uuid(7)) @db.Uuid
  workspaceId    String            @db.Uuid
  workflowId     String            @db.Uuid
  versionId      String            @db.Uuid
  leadId         String?           @db.Uuid
  status         WorkflowRunStatus @default(queued)
  isTest         Boolean           @default(false)
  triggerEvent   Json?
  /// Run variables (reply text, loop counters, test overrides)
  context        Json              @default("{}")
  currentNodeIds String[]          @default([])
  /// Dedupe key, e.g. `${workflowId}:${leadId}:${triggerEventId}`
  idempotencyKey String?
  error          String?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?
  updatedAt      DateTime          @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version   WorkflowVersion   @relation(fields: [versionId], references: [id])
  lead      Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  steps     WorkflowRunStep[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, workflowId, status])
  @@index([workspaceId, leadId])
}

model WorkflowRunStep {
  id           String             @id @default(uuid(7)) @db.Uuid
  workspaceId  String             @db.Uuid
  runId        String             @db.Uuid
  nodeId       String
  nodeType     String
  /// Visit counter for loops (0 on first pass)
  visit        Int                @default(0)
  status       WorkflowStepStatus @default(pending)
  attempt      Int                @default(0)
  branch       String?
  input        Json?
  output       Json?
  summary      String?
  error        String?
  scheduledFor DateTime?
  jobId        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime           @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId, visit])
  @@index([workspaceId, runId])
}

// ---------------------------------------------------------------- integrations & webhooks

model Integration {
  id               String              @id @default(uuid(7)) @db.Uuid
  workspaceId      String              @db.Uuid
  provider         IntegrationProvider
  status           IntegrationStatus   @default(not_connected)
  displayName      String
  /// Non-secret config
  config           Json                @default("{}")
  /// AES-256-GCM (infra/crypto). Never returned by the API.
  secretsEncrypted String?
  lastCheckedAt    DateTime?
  lastError        String?
  connectedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  // ---- change #19 wave C: hub (D-069)
  /// live | mock (mock is refused in production)
  mode                  IntegrationMode @default(live)
  /// Masked hints of the stored secret fields, e.g. { "crmKey": "••••a9f2" }
  secretHints           Json            @default("{}")
  /// AES-256-GCM JSON of tokens Vistar generated for the provider to call us (IndiaMART push key, WhatsApp verify token, telephony callback token)
  inboundTokensEncrypted String?
  lastSyncAt            DateTime?
  /// Next cron pull (IndiaMART); null = not scheduled
  nextSyncAt            DateTime?
  /// Provider cursor, e.g. IndiaMART { "lastWindowEnd": iso, "lastPullAt": iso }
  syncState             Json            @default("{}")
  /// Card numbers (leadsImported30d, lastPulledCount, messagesReceived30d, ...)
  stats                 Json            @default("{}")
  /// Why the status is needs_attention
  attention             String?
  /// Sync claim (one instance runs a pull at a time)
  syncLockedUntil       DateTime?
  connectedById         String?         @db.Uuid
  // ---- end change #19 wave C: hub

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([provider, nextSyncAt])
}

model WebhookEndpoint {
  id              String                @id @default(uuid(7)) @db.Uuid
  workspaceId     String                @db.Uuid
  direction       WebhookDirection
  name            String
  isActive        Boolean               @default(true)
  sourceKey       String?
  action          InboundWebhookAction?
  workflowId      String?               @db.Uuid
  mapping         Json?
  url             String?
  events          String[]              @default([])
  /// AES-256-GCM encrypted HMAC secret
  secretEncrypted String
  secretLast4     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  // ---- change #19 wave C: hub (D-069)
  /// Inbound: hmac (X-Vistar-Signature) or token (X-Vistar-Token / ?token=)
  verification            WebhookVerification?
  /// Inbound update_lead / start_workflow: match keys in order (phone, email)
  matchBy                 String[]  @default([])
  createIfMissing         Boolean   @default(true)
  samplePayload           Json?
  sampleCapturedAt        DateTime?
  /// Capture mode until this time (requests are stored as the sample, not processed)
  captureUntil            DateTime?
  /// Rotation grace: previous secret (AES-256-GCM) accepted inbound / also signed with outbound until previousSecretExpiresAt
  previousSecretEncrypted String?
  previousSecretExpiresAt DateTime?
  secretRotatedAt         DateTime?
  /// Auto-disable after WEBHOOK_AUTO_DISABLE_AFTER_DEAD dead deliveries in a row
  disabledAt              DateTime?
  disabledReason          String?
  consecutiveFailures     Int       @default(0)
  deadStreak              Int       @default(0)
  lastDeliveryAt          DateTime?
  lastSuccessAt           DateTime?
  lastFailureAt           DateTime?
  createdById             String?   @db.Uuid
  // ---- end change #19 wave C: hub

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([workspaceId, sourceKey])
  @@index([workspaceId, direction, isActive])
}

model WebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  workspaceId    String                @db.Uuid
  endpointId     String                @db.Uuid
  direction      WebhookDirection
  event          String?
  eventId        String?
  status         WebhookDeliveryStatus @default(pending)
  attempt        Int                   @default(0)
  /// Sensitive headers redacted before storage
  requestHeaders Json                  @default("{}")
  requestBody    Json?
  responseStatus Int?
  responseBody   String?
  latencyMs      Int?
  error          String?
  idempotencyKey String?
  replayOfId     String?               @db.Uuid
  nextAttemptAt  DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  // ---- change #19 wave C: hub (D-069)
  /// Attempt timeline [{ attempt, at, ok, responseStatus, latencyMs, error }]
  attempts       Json                  @default("[]")
  /// Outbound originals: `${eventId}` (one delivery per event and endpoint across API instances); null for replays, tests and inbound
  dedupeKey      String?
  /// Inbound: signature / token verified (replay is only allowed when true)
  signatureValid Boolean?
  /// Inbound: { action, leadId, runId, duplicate, captured }
  result         Json?
  /// Inbound: SHA-256 of the raw body (same Idempotency-Key with another body = 409)
  bodyHash       String?
  /// Worker claim so one attempt runs at a time (BullMQ job and the sweeper)
  lockedUntil    DateTime?
  // ---- end change #19 wave C: hub

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, dedupeKey])
  @@index([workspaceId, endpointId, createdAt])
  @@index([workspaceId, idempotencyKey])
  @@index([workspaceId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
}

model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  prefix      String
  /// SHA-256 of the full key; plaintext shown once
  keyHash     String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  // ---- change #19 wave C: hub (D-070)
  /// IP of the last request (updated at most once a minute)
  lastUsedIp           String?
  /// Requests per minute; null = API_KEY_DEFAULT_RATE_LIMIT_PER_MIN
  rateLimitPerMinute   Int?
  /// SHA-256 of the key replaced by the last rotation; accepted until previousKeyExpiresAt
  previousKeyHash      String?   @unique
  previousKeyExpiresAt DateTime?
  rotatedAt            DateTime?
  // ---- end change #19 wave C: hub

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------- notifications, audit, settings, targets

model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String
  body        String?
  href        String?
  data        Json             @default("{}")
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt, createdAt])
}

model PushSubscription {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
}

model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  actorType   AuditActorType
  actorId     String?
  actorName   String?
  /// e.g. lead.update, user.role_change, apikey.create
  action      String
  entityType  String
  entityId    String?
  /// PII-safe diff (phones/emails masked)
  diff        Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

model Target {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  userId      String?      @db.Uuid
  teamId      String?      @db.Uuid
  /// "user:<id>" | "team:<id>" | "workspace" (non-null so the unique key works)
  subjectKey  String
  metric      TargetMetric
  /// YYYY-MM in workspace timezone
  period      String
  value       Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, subjectKey, metric, period])
  @@index([workspaceId, period])
}

/// Key/value settings. scope=user -> scopeId = userId (UserSettings, incl. theme). scope=workspace -> scopeId = workspaceId.
model Setting {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  scope       SettingScope
  scopeId     String       @db.Uuid
  key         String
  value       Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, scopeId, key])
}

// ---------------------------------------------------------------- usage, flags, impersonation (tenant tables)

/// Monthly usage metering for plan limits. metric: seats | leads | whatsapp_messages | workflow_runs | storage_mb
model UsageCounter {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  /// YYYY-MM
  period      String
  metric      String
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period, metric])
}

/// Per-company feature flag override set by Super Admin (plan defaults live in PlanDefinition.features).
model FeatureFlagOverride {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  flag        String
  enabled     Boolean
  setById     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, flag])
}

/// Super Admin "View as company". Time-limited, reason required, read-only by default; visible to the company.
model ImpersonationSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  workspaceId   String    @db.Uuid
  adminId       String    @db.Uuid
  reason        String
  readOnly      Boolean   @default(true)
  contentAccess Boolean   @default(false)
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?
  endedReason   String?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  admin     PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([workspaceId, startedAt])
  @@index([adminId, startedAt])
}

// ---------------------------------------------------------------- platform (no workspaceId; never use the tenant client)

model PlatformAdmin {
  id                  String    @id @default(uuid(7)) @db.Uuid
  email               String    @unique
  name                String
  passwordHash        String
  /// AES-256-GCM encrypted base32 TOTP secret; 2FA is mandatory
  totpSecretEncrypted String?
  mfaEnabledAt        DateTime?
  /// Last accepted TOTP time step (replay protection)
  totpLastStep        Int?
  /// PlatformPermission strings
  permissions         String[]
  /// Exact IPs or CIDRs; empty = any
  ipAllowlist         String[]  @default([])
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions       PlatformSession[]
  impersonations ImpersonationSession[]
}

model PlatformSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  adminId      String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  ip           String?
  userAgent    String?
  lastSeenAt   DateTime  @default(now())
  /// Absolute timeout (12 h from login)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([familyId])
}

/// Every Super Admin action. Impersonation and company-affecting actions ALSO write AuditLog in the company.
model PlatformAuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  adminId     String?  @db.Uuid
  adminName   String?
  action      String
  workspaceId String?  @db.Uuid
  entityType  String
  entityId    String?
  reason      String?
  diff        Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model PlanDefinition {
  id              String   @id @default(uuid(7)) @db.Uuid
  key             Plan     @unique
  name            String
  priceInrMonthly Int
  priceInrYearly  Int
  /// PlanLimits JSON (seats, leads, whatsappMessagesPerMonth, workflowRunsPerMonth, storageMb)
  limits          Json
  /// FeatureFlags JSON
  features        Json
  overage         Json?
  trialDays       Int      @default(14)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------- Industry Pack registry (platform; root client only)

/// One pack in the registry, synced from packs/<key>/manifest.json by `pnpm packs:sync`.
model PackDefinition {
  id              String   @id @default(uuid(7)) @db.Uuid
  key             String   @unique
  name            String
  description     String
  industry        String
  icon            String
  /// Core packs are installed in every workspace and cannot be uninstalled
  core            Boolean  @default(false)
  latestVersion   String
  /// Add-on price per workspace per month (whole rupees); null = included in the plan
  priceInrMonthly Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions     PackVersion[]
  entitlements PackPlanEntitlement[]
}

/// Immutable manifest of one pack version (parsed PackManifestSchema output).
model PackVersion {
  id        String   @id @default(uuid(7)) @db.Uuid
  packId    String   @db.Uuid
  version   String
  manifest  Json
  /// SHA-256 of the canonical manifest JSON; a changed file with the same version is rejected by sync
  checksum  String
  createdAt DateTime @default(now())

  pack PackDefinition @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, version])
}

/// Plans that include a pack. Per-company overrides live in WorkspacePack.platformOverride.
model PackPlanEntitlement {
  id        String   @id @default(uuid(7)) @db.Uuid
  packId    String   @db.Uuid
  plan      Plan
  createdAt DateTime @default(now())

  pack PackDefinition @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, plan])
}

// ---------------------------------------------------------------- change #19: devices, presence, attendance (tenant tables)

/// A phone or browser of a user that can receive pushes (FCM). Upsert key: (userId, installationId).
model Device {
  id             String         @id @default(uuid(7)) @db.Uuid
  workspaceId    String         @db.Uuid
  userId         String         @db.Uuid
  platform       DevicePlatform
  installationId String
  /// FCM registration token; globally unique (a token that moves to another user is detached from the old row)
  fcmToken       String?        @unique
  appVersion     String
  appBuild       Int?
  model          String?
  osVersion      String?
  lastSeenAt     DateTime       @default(now())
  /// Set when FCM reports the token as unregistered
  tokenInvalidAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, installationId])
  @@index([workspaceId, userId])
}

/// Current server-decided status of a user (D-062); one row per user.
model Presence {
  id              String          @id @default(uuid(7)) @db.Uuid
  workspaceId     String          @db.Uuid
  userId          String          @unique @db.Uuid
  status          PresenceStatus  @default(offline)
  /// +1 per status change; events and history rows carry it (ordering across API instances)
  version         Int             @default(0)
  source          PresenceSource  @default(system)
  since           DateTime        @default(now())
  /// The employee's own last choice (restored after a call); null = none
  manualStatus    PresenceStatus?
  manualNote      String?
  manualSetAt     DateTime?
  lastHeartbeatAt DateTime?
  lastSeenAt      DateTime?
  /// web | android (last heartbeat)
  client          String?
  clientActivity  String?
  callId          String?         @db.Uuid
  callStartedAt   DateTime?
  leadId          String?         @db.Uuid
  /// Screen the client has open (AppScreen)
  screen          String?
  /// Office zone (seat-map zone id) from BLE / Wi-Fi / QR / NFC / manual signals
  zoneId          String?
  zoneSource      String?
  zoneConfidence  Float?
  zoneSince       DateTime?
  zoneAt          DateTime?
  updatedAt       DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Status history (every change of Presence.status).
model PresenceEvent {
  id             String          @id @default(uuid(7)) @db.Uuid
  workspaceId    String          @db.Uuid
  userId         String          @db.Uuid
  status         PresenceStatus
  previousStatus PresenceStatus?
  /// Presence.version after this change
  version        Int
  source         PresenceSource
  callId         String?         @db.Uuid
  meta           Json?
  at             DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, version])
  @@index([workspaceId, userId, at])
  @@index([workspaceId, at])
}

/// One check-in .. check-out of a field staff member (D-063).
model AttendanceSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  workspaceId      String    @db.Uuid
  userId           String    @db.Uuid
  /// YYYY-MM-DD of the check-in in the workspace timezone
  date             String
  checkInAt        DateTime
  checkInLat       Float
  checkInLng       Float
  checkInAccuracy  Float?
  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  /// manual | end_of_day | admin
  checkOutReason   String?
  deviceId         String?   @db.Uuid
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pings     LocationPing[]

  @@index([workspaceId, date])
  @@index([workspaceId, userId, checkInAt])
}

/// GPS point while checked in and inside working hours. Idempotent by (user, at).
model LocationPing {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  sessionId   String   @db.Uuid
  at          DateTime
  lat         Float
  lng         Float
  accuracy    Float?
  speed       Float?
  heading     Float?
  battery     Int?
  createdAt   DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, at])
  @@index([workspaceId, sessionId, at])
}

/// Tracking consent history of an employee (DPDP); the latest row is the current state.
model TrackingConsent {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  version     String
  accepted    Boolean
  deviceId    String?  @db.Uuid
  ip          String?
  userAgent   String?
  at          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, at])
}

/// Marks an office zone for indoor location: BLE beacon, Wi-Fi access point, QR code or NFC tag.
model OfficeMarker {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  /// ble_beacon | wifi_ap | qr | nfc
  kind        String
  zoneId      String
  label       String
  beaconUuid  String?
  beaconMajor Int?
  beaconMinor Int?
  /// lower-case aa:bb:cc:dd:ee:ff
  bssid       String?
  /// SHA-256 of the QR / NFC token
  tokenHash   String?  @unique
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, beaconUuid, beaconMajor, beaconMinor])
  @@unique([workspaceId, bssid])
  @@index([workspaceId, zoneId])
}

// ---------------------------------------------------------------- change #19: custom domain, custom floors (tenant tables)

/// One custom domain per company (D-060); resolved only when verified and the custom_domain flag is on.
model CustomDomain {
  id            String             @id @default(uuid(7)) @db.Uuid
  workspaceId   String             @unique @db.Uuid
  hostname      String             @unique
  status        CustomDomainStatus @default(pending)
  txtToken      String
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// A company's request for a custom 3D floor, with reference images (D-061).
model FloorRequest {
  id               String             @id @default(uuid(7)) @db.Uuid
  workspaceId      String             @db.Uuid
  status           FloorRequestStatus @default(submitted)
  headcount        Int
  notes            String?
  /// Message from the Super Admin to the company
  statusNote       String?
  createdById      String?            @db.Uuid
  handledByAdminId String?            @db.Uuid
  publishedFloorId String?            @db.Uuid
  submittedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  images    FloorRequestImage[]

  @@index([workspaceId, submittedAt])
  @@index([status, submittedAt])
}

model FloorRequestImage {
  id          String             @id @default(uuid(7)) @db.Uuid
  workspaceId String             @db.Uuid
  requestId   String             @db.Uuid
  fileId      String             @db.Uuid
  category    FloorImageCategory
  caption     String?
  order       Int

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   FloorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, fileId])
  @@index([workspaceId, requestId])
}

/// A floor model (GLB / zipped glTF) uploaded by the Super Admin for a company, versioned per company.
model FloorAsset {
  id                 String           @id @default(uuid(7)) @db.Uuid
  workspaceId        String           @db.Uuid
  requestId          String?          @db.Uuid
  version            Int
  status             FloorAssetStatus @default(draft)
  format             FloorModelFormat
  modelFileId        String           @db.Uuid
  /// SeatMap JSON (packages/shared schemas/floor.ts); null until the seat tool saves it
  seatMap            Json?
  notes              String?
  uploadedByAdminId  String?          @db.Uuid
  publishedAt        DateTime?
  publishedByAdminId String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, version])
  @@index([workspaceId, status])
}

// ---------------------------------------------------------------- change #19: platform tables (root client only)

/// Platform-level file (APKs). Company files, including floor models a Super Admin uploads, are tenant File rows.
model PlatformFile {
  id           String      @id @default(uuid(7)) @db.Uuid
  purpose      FilePurpose
  key          String
  name         String
  mime         String
  size         Int
  sha256       String
  driver       String      @default("local")
  uploadedById String?     @db.Uuid
  createdAt    DateTime    @default(now())

  androidRelease AndroidRelease?
}

/// Platform key/value settings. Secret values live only in `secretEncrypted` (AES-256-GCM, ENCRYPTION_KEY).
/// Keys: firebase.client (value = FirebaseClientOptions, secret = original file), firebase.serviceAccount (secret only; value = public status).
model PlatformSetting {
  id              String   @id @default(uuid(7)) @db.Uuid
  key             String   @unique
  value           Json?
  secretEncrypted String?
  updatedById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Android APK release (D-058); the employee panel links to the newest one.
model AndroidRelease {
  id           String       @id @default(uuid(7)) @db.Uuid
  versionName  String
  versionCode  Int          @unique
  notes        String?
  fileId       String       @unique @db.Uuid
  size         Int
  sha256       String
  minSupported Boolean      @default(false)
  uploadedById String?      @db.Uuid
  createdAt    DateTime     @default(now())

  file PlatformFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}
