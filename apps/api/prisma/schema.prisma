// ---------------------------------------------------------------- tenancy, auth, team

model Workspace {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String
  slug              String    @unique
  timezone          String    @default("Asia/Kolkata")
  currency          String    @default("INR")
  businessHours     Json
  holidays          Json      @default("[]")
  status            WorkspaceStatus @default(active)
  plan              Plan      @default(free)
  trialEndsAt       DateTime?
  /// Super Admin support access (impersonation) allowed until; null = off
  supportAccessUntil   DateTime?
  /// Allow message bodies / recordings during impersonation
  supportAccessContent Boolean @default(false)
  logoUrl           String?
  accentColor       String?
  defaultTheme      ThemeMode @default(system)
  dataRetentionDays Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  users             User[]
  roles             Role[]
  teams             Team[]
  sessions          Session[]
  invites           Invite[]
  companies         Company[]
  contacts          Contact[]
  pipelines         Pipeline[]
  stages            Stage[]
  leads             Lead[]
  deals             Deal[]
  activities        Activity[]
  calls             Call[]
  conversations     Conversation[]
  messages          Message[]
  templates         Template[]
  quickReplies      QuickReply[]
  tasks             Task[]
  workflows         Workflow[]
  workflowVersions  WorkflowVersion[]
  workflowRuns      WorkflowRun[]
  workflowRunSteps  WorkflowRunStep[]
  integrations      Integration[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  apiKeys           ApiKey[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  targets           Target[]
  settings          Setting[]
  consentRecords    ConsentRecord[]
  tags              Tag[]
  customFields      CustomField[]
  customObjects     CustomObject[]
  customRecords     CustomRecord[]
  workspacePacks    WorkspacePack[]
  packInstallLogs   PackInstallLog[]
  savedViews        SavedView[]
  files             File[]
  importJobs        ImportJob[]
  impersonations    ImpersonationSession[]
  flagOverrides     FeatureFlagOverride[]
  usageCounters     UsageCounter[]
  devices           Device[]
  presences         Presence[]
  presenceEvents    PresenceEvent[]
  attendanceSessions AttendanceSession[]
  locationPings     LocationPing[]
  trackingConsents  TrackingConsent[]
  officeMarkers     OfficeMarker[]
  customDomain      CustomDomain?
  floorRequests     FloorRequest[]
  floorRequestImages FloorRequestImage[]
  floorAssets       FloorAsset[]
  dealLines         DealLine[]
  products          Product[]
  priceLists        PriceList[]
  priceListItems    PriceListItem[]
  documentSeries    DocumentSeries[]
  quotations        Quotation[]
  quotationLines    QuotationLine[]
  invoices          Invoice[]
  invoiceLines      InvoiceLine[]
  payments          Payment[]
  crmNotes          CrmNote[]
  meetings          Meeting[]
  meetingAttendees  MeetingAttendee[]
  meetingReminders  MeetingReminderLog[]
  timeOff           TimeOff[]
  routingRules      RoutingRule[]
  captureForms      CaptureForm[]
  captureSubmissions CaptureSubmission[]
}

model User {
  id              String         @id @default(uuid(7)) @db.Uuid
  workspaceId     String         @db.Uuid
  /// Globally unique: one user belongs to one workspace (DECISIONS.md D-008).
  email           String         @unique
  passwordHash    String?
  googleSub       String?        @unique
  name            String
  phone           String?
  title           String?
  roleId          String         @db.Uuid
  teamId          String?        @db.Uuid
  status          EmployeeStatus @default(offline)
  statusChangedAt DateTime?
  lastSeenAt      DateTime?
  isActive        Boolean        @default(true)
  /// AvatarConfig (Team Floor customisation)
  avatar          Json?
  /// BusinessHours JSON; null = workspace hours
  workingHours    Json?
  deskIndex       Int?
  /// Field staff: attendance check-in/out and GPS tracking in working hours (D-063); set by a company admin
  isFieldStaff    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role              Role               @relation(fields: [roleId], references: [id])
  team              Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  managedTeams      Team[]             @relation("TeamManager")
  sessions          Session[]
  ownedLeads        Lead[]             @relation("LeadOwner")
  assignedTasks     Task[]             @relation("TaskAssignee")
  calls             Call[]
  conversations     Conversation[]     @relation("ConversationAssignee")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  targets           Target[]
  ownedRecords      CustomRecord[]     @relation("RecordOwner")
  devices           Device[]
  presence          Presence?
  presenceEvents    PresenceEvent[]
  attendanceSessions AttendanceSession[]
  locationPings     LocationPing[]
  trackingConsents  TrackingConsent[]
  ownedContacts     Contact[]          @relation("ContactOwner")
  ownedCompanies    Company[]          @relation("CompanyOwner")
  ownedDeals        Deal[]             @relation("DealOwner")
  ownedQuotations   Quotation[]        @relation("QuotationOwner")
  ownedInvoices     Invoice[]          @relation("InvoiceOwner")
  organizedMeetings Meeting[]          @relation("MeetingOrganizer")
  timeOff           TimeOff[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, status])
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  /// Slug; system roles use the kind name, custom roles any other slug
  key         String
  name        String
  kind        RoleKind
  dataScope   DataScope
  /// Permission strings from @vistar/shared PERMISSIONS
  permissions String[]
  isSystem    Boolean  @default(true)
  /// Pack that created the role (null = system or workspace-defined)
  packKey     String?
  /// Archived by a pack uninstall/upgrade; hidden from role pickers, members keep it
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  users     User[]

  @@unique([workspaceId, key])
}

model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  managerId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  manager   User?     @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   User[]    @relation("TeamMembers")
  targets   Target[]

  @@unique([workspaceId, name])
}

/// Refresh-token session. Rotated on every refresh; reuse of a revoked token revokes the family.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([familyId])
}

model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  email       String?
  roleId      String    @db.Uuid
  teamId      String?   @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

// ---------------------------------------------------------------- CRM core

/// Account (a customer company) in the CRM; "Company" in the Super Admin means a workspace. Change #19 wave B adds the CRM fields.
model Company {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  gstin       String?
  pan         String?
  industry    String?
  phone       String?
  email       String?
  /// LabeledPhone[] / LabeledEmail[] (schemas/crm.ts)
  additionalPhones Json @default("[]")
  additionalEmails Json @default("[]")
  /// Address (schemas/crm.ts) incl. the GST stateCode
  billingAddress  Json?
  shippingAddress Json?
  city        String?
  state       String?
  /// GST state code of the billing address (denormalised for filters)
  stateCode   String?
  website     String?
  ownerId     String?   @db.Uuid
  tags        String[]  @default([])
  customFields Json     @default("{}")
  mergedIntoId String?  @db.Uuid
  lastActivityAt DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      User?       @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  leads      Lead[]
  deals      Deal[]
  quotations Quotation[]
  invoices   Invoice[]
  meetings   Meeting[]

  @@index([workspaceId, name])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, gstin])
  @@index([tags], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Company_name_trgm_idx")
}

model Contact {
  id            String         @id @default(uuid(7)) @db.Uuid
  workspaceId   String         @db.Uuid
  name          String
  /// Designation
  title         String?
  /// E.164
  phone         String?
  email         String?
  additionalPhones Json        @default("[]")
  additionalEmails Json        @default("[]")
  companyId     String?        @db.Uuid
  city          String?
  stateCode     String?
  gstin         String?
  pan           String?
  billingAddress  Json?
  shippingAddress Json?
  ownerId       String?        @db.Uuid
  tags          String[]       @default([])
  /// Latest WhatsApp consent (denormalised from ConsentRecord)
  whatsappOptIn ConsentStatus?
  dnd           Boolean        @default(false)
  customFields  Json           @default("{}")
  mergedIntoId  String?        @db.Uuid
  lastActivityAt DateTime?
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?           @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads         Lead[]
  conversations Conversation[]
  consents      ConsentRecord[]
  deals         Deal[]
  quotations    Quotation[]
  invoices      Invoice[]
  meetings      Meeting[]
  meetingAttendees MeetingAttendee[]

  @@unique([workspaceId, phone])
  @@index([workspaceId, email])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
  @@index([tags], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm_idx")
}

model Pipeline {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  /// Stable slug, unique per workspace ("sales" = default pipeline). Packs match pipelines by key.
  key         String
  name        String
  isDefault   Boolean   @default(false)
  /// lead (Leads board) | deal (Deals board; default key "deals"). Change #19 wave B.
  entity      String    @default("lead")
  /// Pack that created the pipeline (null = workspace-defined)
  packKey     String?
  /// Archived by a pack uninstall; leads in it are kept
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  leads     Lead[]
  deals     Deal[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model Stage {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  pipelineId  String    @db.Uuid
  key         String
  name        String
  type        StageType @default(open)
  order       Int
  color       String?
  probability Int       @default(10)
  /// Archived by a pack upgrade (only when empty); hidden from the board
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads     Lead[]
  deals     Deal[]

  @@unique([pipelineId, key])
  @@index([workspaceId, pipelineId, order])
}

model Lead {
  id              String          @id @default(uuid(7)) @db.Uuid
  workspaceId     String          @db.Uuid
  name            String
  companyName     String?
  phone           String?
  email           String?
  city            String?
  state           String?
  source          LeadSource      @default(manual)
  /// External id (e.g. IndiaMART UNIQUE_QUERY_ID) for idempotent ingestion
  sourceRef       String?
  productInterest String?
  requirement     String?
  ownerId         String?         @db.Uuid
  pipelineId      String          @db.Uuid
  stageId         String          @db.Uuid
  /// Fractional index within the stage. Column uses COLLATE "C" (byte order; migration 20261101120000)
  position        String
  valueInr        Int             @default(0)
  score           Int             @default(0)
  scoreBreakdown  Json            @default("[]")
  temperature     LeadTemperature @default(warm)
  tags            String[]        @default([])
  customFields    Json            @default("{}")
  contactId       String?         @db.Uuid
  companyId       String?         @db.Uuid
  nextFollowUpAt  DateTime?
  lastActivityAt  DateTime?
  firstResponseAt DateTime?
  stageChangedAt  DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  mergedIntoId    String?         @db.Uuid
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id])
  stage        Stage         @relation(fields: [stageId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  mergedInto   Lead?         @relation("LeadMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedLeads  Lead[]        @relation("LeadMerge")
  deals        Deal[]
  activities   Activity[]
  calls        Call[]
  tasks        Task[]
  workflowRuns WorkflowRun[]
  files        File[]
  quotations   Quotation[]
  invoices     Invoice[]
  meetings     Meeting[]

  @@unique([workspaceId, source, sourceRef])
  @@index([workspaceId, stageId, position])
  @@index([workspaceId, ownerId, stageId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, phone])
  @@index([workspaceId, email])
  @@index([workspaceId, nextFollowUpAt])
  @@index([tags], type: Gin)
  // Trigram indexes for case-insensitive contains search (pg_trgm extension created by migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_name_trgm_idx")
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_companyName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_phone_trgm_idx")
  @@index([requirement(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_requirement_trgm_idx")
}

/// Deal (opportunity). D-007: the Leads board moves leads, deals hold revenue. Change #19 wave B: deals also
/// live on a deal pipeline (Pipeline.entity = deal) with their own stage and position, owner, account,
/// contact and product lines; leadId is optional (deals can start from an account).
model Deal {
  id              String    @id @default(uuid(7)) @db.Uuid
  workspaceId     String    @db.Uuid
  leadId          String?   @db.Uuid
  title           String
  valueInr        Int       @default(0)
  status          StageType @default(open)
  /// null only for legacy rows; the deals service backfills from the default deal pipeline
  pipelineId      String?   @db.Uuid
  stageId         String?   @db.Uuid
  /// Fractional index within the stage. Column uses COLLATE "C" (migration 20261103000000)
  position        String    @default("a0")
  /// Probability override 0-100 (null = stage probability)
  probability     Int?
  ownerId         String?   @db.Uuid
  companyId       String?   @db.Uuid
  contactId       String?   @db.Uuid
  description     String?
  lostReason      String?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  customFields    Json      @default("{}")
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pipeline   Pipeline?   @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage      Stage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  owner      User?       @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lines      DealLine[]
  quotations Quotation[]
  invoices   Invoice[]
  meetings   Meeting[]

  @@index([workspaceId, leadId])
  @@index([workspaceId, status, closedAt])
  @@index([workspaceId, stageId, position])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, contactId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Deal_title_trgm_idx")
}

/// Product line of a deal (prices exclude GST; money in paise, D-067).
model DealLine {
