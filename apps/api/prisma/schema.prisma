/// Manually recorded payment. Voided payments stay (audit trail) and are excluded from Invoice.paidPaise.
model Payment {
  id              String      @id @default(uuid(7)) @db.Uuid
  workspaceId     String      @db.Uuid
  invoiceId       String      @db.Uuid
  amountPaise     BigInt
  paidOn          DateTime    @db.Date
  mode            PaymentMode
  reference       String?
  note            String?
  /// Idempotency key from the client (unique per invoice)
  clientPaymentId String?
  recordedById    String?     @db.Uuid
  voidedAt        DateTime?
  voidedById      String?     @db.Uuid
  createdAt       DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, clientPaymentId])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, paidOn])
