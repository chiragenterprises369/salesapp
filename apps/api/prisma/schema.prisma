  taxablePaise   BigInt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, dealId, position])
}

// ---------------------------------------------------------------- change #19 wave B: catalog, documents, calendar, routing, capture

/// Product or service (SPEC 29.9). Money in paise; price excludes GST.
model Product {
  id             String   @id @default(uuid(7)) @db.Uuid
  workspaceId    String   @db.Uuid
  sku            String
  name           String
  description    String?
  /// goods | service
  kind           String   @default("goods")
  /// HSN (goods) or SAC (services)
  hsnSac         String
  /// GST UQC code (PRODUCT_UNITS)
  unit           String   @default("NOS")
  /// 0 | 5 | 12 | 18 | 28
  gstRate        Int
  unitPricePaise BigInt
  active         Boolean  @default(true)
  customFields   Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
