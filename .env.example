# Copy to .env (root). Never commit .env. All secrets are server-only.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser; never put secrets there.

# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# ---- Database / cache (local Docker Compose defaults) ----
DATABASE_URL=postgresql://vistar:vistar@localhost:5432/vistar?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Super Admin tokens use a separate secret and audience; a workspace token can never call /api/super.
SUPER_JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ---- Encryption of integration secrets at rest (32 bytes, base64) ----
ENCRYPTION_KEY=

# ---- Object storage (S3-compatible: MinIO locally, or Bunny Storage e.g. S3_ENDPOINT=https://de-s3.storage.bunnycdn.com, S3_REGION=de, S3_BUCKET=<storage zone>) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=vistar
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Public CDN base for files that may be public (Bunny pull zone). Private files (recordings, documents) use signed URLs only.
S3_PUBLIC_BASE_URL=

# ---- Uploads (D-065): local disk driver for development; s3 uses the S3_* values above ----
STORAGE_DRIVER=local
# Default <repo root>/.data/uploads (gitignored)
STORAGE_LOCAL_ROOT=
# Signed download URL lifetime in seconds
FILE_URL_TTL_SEC=900

# ---- Custom domains (D-060): CNAME target in the DNS instructions (your load balancer host in production) ----
CUSTOM_DOMAIN_CNAME_TARGET=localhost

# ---- Dev CORS: also allow http://localhost:<port> for this range (web 3000-3009, Flutter web preview 3010); ignored in production ----
DEV_CORS_PORTS=3000-3010

# Firebase (push) and the Android APK are configured in the Super Admin panel (Config section), not here.

# ---- Email (SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vistar <no-reply@vistar.local>"

# ---- WhatsApp Cloud API (app-level; per-workspace tokens are stored encrypted in Integration) ----
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# ---- Telephony (Exotel-style adapter) ----
TELEPHONY_PROVIDER=mock
# ---- change #19 wave C: hub
# Hosts outbound webhooks and SMTP may reach although private (dev receivers on localhost, Mailpit). Ignored in production.
# OUTBOUND_ALLOW_PRIVATE_HOSTS=localhost,127.0.0.1,::1
# IndiaMART pull API and Meta Graph API base URLs (defaults shown)
# INDIAMART_API_URL=https://mapi.indiamart.com/wservce/crm/crmListing/v2/
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# Background hub jobs in this process (outbound webhook worker and sweeper, IndiaMART pull cron): on | off
HUB_BACKGROUND_JOBS=on
# ---- end change #19 wave C: hub

# ---- change #19 wave C: billing (D-072) ----
# Checkout provider: auto = Razorpay when saved in Super Admin > Config (key id, key secret, webhook secret are stored
# encrypted there, never here), else the local mock outside production; mock | razorpay | none force one.
BILLING_PROVIDER=auto
# Mock checkout and mock webhook signing secret (development and tests only; the API refuses the mock in production).
BILLING_MOCK_SECRET=vistar-dev-mock-razorpay-secret

# ---- Feature flags ----
FEATURE_AI_NODE=false

# Express "trust proxy" behind a load balancer (e.g. 1 or loopback). Leave empty locally.
TRUST_PROXY=

# ---- Web (browser-safe values only) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Map tiles for the web attendance field map (Leaflet). Optional: empty = the OpenStreetMap standard
# tiles with the OSM attribution. Those tiles follow the OSM tile usage policy
# (https://operations.osmfoundation.org/policies/tiles/): fine for development and light use, not for
# heavy production traffic, and the attribution must stay visible. For production use a tile provider
# or your own tile server and set both values, e.g.
#   NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
#   NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; Example Tiles
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# ---- Fizzly Workflows API (asset generation script only; server-side, never sent to the browser) ----
FIZZLY_API_KEY=
FIZZLY_WORKFLOW=
FIZZLY_MAX_CREDITS=
